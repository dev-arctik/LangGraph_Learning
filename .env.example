# OpenAI API Key - Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your_openai_api_key_here

# LangSmith Configuration - Get from https://smith.langchain.com/
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
LANGCHAIN_API_KEY="lsv2_pt_your_langchain_api_key_here"
LANGCHAIN_PROJECT="Your LangChain Project Name"

# MongoDB Connection String - Get from MongoDB Atlas
MONGO_URI="mongodb+srv://username:password@cluster.mongodb.net/"

# Tavily API Key for web search - Get from https://tavily.com/
TAVILY_API_KEY=tvly-your_tavily_api_key_here
